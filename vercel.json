{
  "rewrites": [
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/.well-known/openid-configuration.json"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/.well-known/oauth-authorization-server.json"
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "/.well-known/jwks.json"
    },
    {
      "source": "/mcp",
      "destination": "https://runwall.onrender.com/mcp"
    },
    {
      "source": "/sse",
      "destination": "https://runwall.onrender.com/sse"
    },
    {
      "source": "/messages",
      "destination": "https://runwall.onrender.com/messages"
    },
    {
      "source": "/health",
      "destination": "https://runwall.onrender.com/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://runwall.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}